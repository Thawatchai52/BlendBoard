// prisma/schema.prisma
// ระบบมี 2 สิทธิ์ (VIEWER / ADMIN) จาก cookie ที่เซิร์ฟเวอร์เซ็น ไม่มีบัญชีรายคน
// จึงไม่มีตาราง User — ประวัติ/คอมเมนต์เก็บเป็น "ใครทำในบทบาทไหน" (actorRole) แทน
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT        // Draft
  IN_REVIEW    // รอตรวจ
  REVISION     // ให้แก้
  APPROVED     // Approved
  POSTED       // Posted
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  LINE_OA
  X
}

enum AttachmentKind {
  IMAGE
  VIDEO
  DOCUMENT
  LINK       // ลิงก์ภายนอก (เช่น คลิป TikTok) เก็บใน url ไม่มีไฟล์ใน storage
}

enum AttachmentPurpose {
  REFERENCE    // ไฟล์บรีฟ (Admin แนบ)
  DELIVERABLE  // ไฟล์/ลิงก์ส่งงาน (Viewer หรือ Admin แนบ)
}

enum ActorRole {
  VIEWER
  ADMIN
}

model Brand {
  id    String @id @default(cuid())
  code  String @unique // "KS", "BL"
  name  String          // "Kudsan", "Bellinee's"
  color String          // hex เช่น "#F97316"

  tasks ContentTask[]
}

model ContentTask {
  id          String        @id @default(cuid())
  title       String
  caption     String?       @db.Text // Caption / Copywriting
  status      ContentStatus @default(DRAFT)
  platforms   Platform[]    // ลงได้หลายแพลตฟอร์ม
  publishDate DateTime      // วัน-เวลาที่จะโพสต์ (ใช้แสดงในปฏิทิน)
  briefDueAt  DateTime?     // กำหนดส่งบรีฟ/งานดีไซน์ (ใช้เตือน)
  position    Int           @default(0) // ลำดับในคอลัมน์ Kanban
  notifiedAt  DateTime?     // กันเตือนซ้ำ

  revisionNote  String?  @db.Text // สิ่งที่ต้องแก้ล่าสุด (จากการตีกลับ)
  revisionRound Int      @default(0)
  submittedAt   DateTime?

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  attachments Attachment[]
  history     StatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, publishDate])
  @@index([status])
  @@index([publishDate])
}

model Attachment {
  id       String            @id @default(cuid())
  taskId   String
  task     ContentTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind     AttachmentKind
  purpose  AttachmentPurpose @default(REFERENCE)
  fileName String
  mimeType String
  size     Int               // bytes (LINK = 0)
  key      String?           // path ใน storage (LINK = null) ต้องขึ้นต้นด้วย brandId/
  url      String?           // เฉพาะ LINK  ไฟล์ใน storage ออก URL ชั่วคราวตอนอ่าน
  uploadedByRole ActorRole   @default(ADMIN)
  uploadedAt DateTime        @default(now())

  @@index([taskId])
}

model StatusHistory {
  id         String         @id @default(cuid())
  taskId     String
  task       ContentTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus ContentStatus?
  toStatus   ContentStatus
  actorRole  ActorRole
  comment    String?        @db.Text // เหตุผลที่ตีกลับ / หมายเหตุ
  changedAt  DateTime       @default(now())

  @@index([taskId])
}

// ------------------------------ TikTok Analytics ------------------------------
enum FetchStatus {
  PENDING   // รับลิงก์แล้ว รอดึง
  FETCHING  // กำลังดึง (ล็อกกันดึงซ้ำ)
  OK        // ดึงสำเร็จ
  FAILED    // ดึงไม่สำเร็จ (ดู error / attempts)
}

model TikTokPost {
  id            String      @id @default(cuid())
  url           String      @unique            // normalize แล้ว (ตัด query/hash)
  videoId       String?     @unique            // ได้จาก URL หรือจากผลของผู้ให้บริการ (ลิงก์สั้น)
  status        FetchStatus @default(PENDING)
  error         String?
  attempts      Int         @default(0)        // ล้มเหลวติดกันกี่ครั้ง (cron เลิกลองเมื่อครบ 5)

  // ยอดล่าสุด  null = ยังไม่เคยดึงได้ / ผู้ให้บริการไม่มีฟิลด์นี้
  views         Int?
  likes         Int?
  comments      Int?
  shares        Int?
  saves         Int?

  authorHandle  String?
  caption       String?
  postedAt      DateTime?

  submittedAt   DateTime    @default(now())
  lastFetchedAt DateTime?
  updatedAt     DateTime    @updatedAt

  snapshots     TikTokSnapshot[]

  @@index([status, lastFetchedAt])
  @@index([submittedAt])
}

// ประวัติยอดทุกครั้งที่ดึง ใช้ทำกราฟโตตามเวลาได้ภายหลัง ไม่ต้องเก็บ ER (คำนวณตอนอ่าน)
model TikTokSnapshot {
  id       String     @id @default(cuid())
  postId   String
  post     TikTokPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  takenAt  DateTime   @default(now())
  views    Int?
  likes    Int?
  comments Int?
  shares   Int?
  saves    Int?

  @@index([postId, takenAt])
}
