# ผู้ให้บริการดึงสถิติ (ตอนนี้มี adapter: apify)
TIKTOK_PROVIDER=apify
APIFY_TOKEN=
# รูปแบบ  ชื่อผู้ใช้~ชื่อactor  (เลือก Actor แบบ "รับลิงก์คลิป" แล้วทดสอบกับลิงก์จริงก่อน)
APIFY_TIKTOK_ACTOR=
# ชื่อช่อง input ที่ Actor ใช้รับลิงก์ เช่น postURLs หรือ videoUrls (ดูหน้า Input ของ Actor)
APIFY_URL_FIELD=postURLs

# ความลับของ cron (สุ่มยาว ๆ) — ต้องส่งเป็น  Authorization: Bearer <ค่านี้>
CRON_SECRET=

# ระบบเข้าสู่ระบบ 2 ประตู
SESSION_SECRET=      # สุ่มยาว ๆ ใช้เซ็น cookie role
ADMIN_PASSWORD=      # รหัสฝั่ง Admin (ถ้าไม่ตั้ง โค้ดจะใช้ค่าเริ่มต้น ควรตั้งเสมอ)
DATABASE_URL=        # Postgres (Supabase / Neon)

# ที่เก็บไฟล์แนบ (S3-compatible: Cloudflare R2 / Supabase Storage / AWS S3)  ใช้ URL แบบ path-style
S3_ENDPOINT=         # เช่น https://<account>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Trend Radar (ดึงคลิปตามแฮชแท็ก)  ตรวจ input/output ของ Actor ที่เลือกก่อนใช้ — ดูหัวไฟล์ lib/providers/apify-trends.ts
APIFY_TREND_ACTOR=clockworks~tiktok-scraper
APIFY_TREND_FIELD=hashtags
APIFY_TREND_LIMIT=20
